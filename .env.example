# Copy to .env.local for local development. On Vercel, set these under
# Settings → Environments, separately for Production and Preview.
# NEXT_PUBLIC_* values are public (sent to the browser) and read at BUILD time: redeploy after changing.
# Everything else is server-only and must never be prefixed with NEXT_PUBLIC_.
# Run `npm run launch:check` to see what is still missing for a public launch.

# ── Site ────────────────────────────────────────────────────────────────────
# Public site URL, no trailing slash (canonical URLs, sitemap, Open Graph, structured data).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Search-engine indexing. Leave empty until launch on the real domain, then set to "on" (Production only).
SITE_INDEXING=

# ── Public contact details (hidden on the site while empty) ─────────────────
NEXT_PUBLIC_CONTACT_EMAIL=
# Shown in the privacy policy. Falls back to the contact email.
NEXT_PUBLIC_PRIVACY_EMAIL=
# Registered entity (footer + privacy policy). TODO(legal).
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_REGISTRATION=

# Social profiles (hidden while empty)
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=

# ── Forms: delivery ─────────────────────────────────────────────────────────
# "log" = accept submissions and only write them to the server log (Preview/staging).
# Leave EMPTY in Production. Without any delivery configured, production rejects
# submissions with a clear error, so nothing is silently lost.
FORM_DELIVERY=
# Resend (https://resend.com). The sender domain must be verified in Resend.
RESEND_API_KEY=
FORM_FROM="ServUS Website <website@your-domain>"
# "on" = also email the visitor a confirmation with their reference (no form content included).
FORM_CONFIRMATION=

# One inbox per form. Several addresses can be comma-separated.
# Current plan (5 Oct 2026), two mailboxes:
#   general  (owner: Jesse)          → FORM_TO_GENERAL, FORM_TO_SUPPORT
#   business (sales + marketing)     → FORM_TO_SERVICE, FORM_TO_PARTNERSHIP, FORM_TO_DEMO, FORM_TO_WAITLIST
FORM_TO_SERVICE=
FORM_TO_PARTNERSHIP=
FORM_TO_DEMO=
FORM_TO_GENERAL=
FORM_TO_SUPPORT=
# Product waiting lists (MOAMBEIRA interest, product updates). Falls back to FORM_TO_GENERAL.
FORM_TO_WAITLIST=

# ── Forms: durable record (optional, recommended) ───────────────────────────
# Every submission is also POSTed as JSON to this URL. For Google Sheets use the free Apps Script
# receiver in integrations/google-sheets-record.gs and put its key in the URL: https://script.google.com/…/exec?key=…
FORM_WEBHOOK_URL=
# Sent as "Authorization: Bearer <secret>" so the receiver can reject strangers.
FORM_WEBHOOK_SECRET=

# ── Alerts (optional, recommended) ──────────────────────────────────────────
# Incoming-webhook URL of a Slack / Discord / Teams / Google Chat channel. Receives a short
# message (form type + reference, never form content) whenever a delivery fails.
ALERT_WEBHOOK_URL=
