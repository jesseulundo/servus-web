# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.servus.example
NEXT_PUBLIC_CONTACT_EMAIL=hello@servus.example

# Search-engine indexing. Leave empty until launch on the real domain, then set to "on".
SITE_INDEXING=

# Optional social profiles (hidden when empty)
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=

# Transactional email (Resend). Without a key, submissions are logged in development
# and rejected with 503 in production so nothing is silently lost.
RESEND_API_KEY=
# Set to "log" on staging/previews to accept submissions without sending email.
FORM_DELIVERY=
FORM_FROM="Servus Website <website@servus.example>"

# One inbox per form (blueprint: "Destino"). TODO(ops): confirm owners.
FORM_TO_SERVICE=sales@servus.example
FORM_TO_PARTNERSHIP=partnerships@servus.example
FORM_TO_DEMO=rh@servus.example
FORM_TO_GENERAL=hello@servus.example
FORM_TO_SUPPORT=support@servus.example
